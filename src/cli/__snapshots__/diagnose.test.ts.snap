// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderDiagnose > renders a compiler-style block for a dynamic-prefix-content finding (snapshot) 1`] = `
"cachelens diagnose — 1 finding

session-1 / planner (call-2)
  dynamic-prefix-content at system[0].text (wire-body offset 63, tier: system)

    ":"You are an agent. Current time: 2026-11-01T03:30:00Z."}][]

  wasted: 300 tokens (~$0.0010)
  fix: Move the dynamic content at system[0].text (wire-body offset 63) after the last stable cache breakpoint, or exclude it from the cached prefix entirely.
"
`;

exports[`renderDiagnose > renders a per-tier wasted-$ breakdown for a multi-tier finding (tiered counterfactual) 1`] = `
"cachelens diagnose — 1 finding

session-1 / planner (call-2)
  request-param-invalidation at params (wire-body offset 0, tier: tools+system+messages)

    model: "claude-sonnet-4-5" -> "claude-opus-4-5"

  wasted: 300 tokens (~$0.0017)

  wasted by tier (approximate — see docs):
    tools      ~$0.0003
    system     ~$0.0010
    messages   ~$0.0004
  fix: Keep \`model\` (and tool definitions) fixed for this step — a model change invalidates the entire cache prefix, all tiers.
"
`;
