{
  "name": "cachelens",
  "version": "1.0.0",
  "description": "Internal token-economics profiler for LLM agent pipelines: cost distribution, cache hit rate, and byte-level prompt-cache-miss root-cause diagnostics, run as a CI gate.",
  "keywords": ["llm", "prompt-caching", "cost-observability", "cli", "ci-gate", "anthropic"],
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cachelens": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/cli/index.js",
    "./capture/wrap/anthropic": {
      "types": "./dist/capture/wrap/anthropic.d.ts",
      "default": "./dist/capture/wrap/anthropic.js"
    },
    "./capture/wrap/openai": {
      "types": "./dist/capture/wrap/openai.d.ts",
      "default": "./dist/capture/wrap/openai.js"
    },
    "./store/jsonl": {
      "types": "./dist/store/jsonl.d.ts",
      "default": "./dist/store/jsonl.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "generate:demo-fixtures": "npm run build && node dist/scripts/generate-demo-fixtures.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "@biomejs/biome@1.9.4": true,
    "esbuild@0.21.5": true
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1"
  }
}
